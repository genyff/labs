#Визначити чверть координатної площини, якій належить точка.
#Координати точки ввести з клавіатури в одну строку через пробіл.
a = input("Введіть координати x та y через пробіл: ")
x,y= map(int, a.split())
if x > 0 and y > 0 :
    print("Перша чверть")
elif x<0 and y>0 :
    print("Друга чверть")
elif x<0 and y<0 :
    print("Третя чверть")
elif x>0 and y<0 :
    print("Четверта чверть")
else: print("Середина координатної площини")



